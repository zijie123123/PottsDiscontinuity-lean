module

public import Mathlib.Analysis.SpecialFunctions.Complex.Circle
public import Mathlib.Topology.Homotopy.Lifting
public import Mathlib.Topology.Homotopy.Path
public import PottsDiscontinuity.Duality.ConnectionEvents
public import PottsDiscontinuity.FK.Events
public import PottsDiscontinuity.FK.SubgraphComparison

/-! Finite increasing cylinder events of an embedded graph. -/

@[expose] public section

namespace PottsDiscontinuity.TorusExploration
open FK MeasureTheory
variable {V : Type*} [Finite V] (G : SimpleGraph V)
noncomputable section
open scoped Classical
local instance embeddedCylinderEdgeFintype : Fintype G.edgeSet := Fintype.ofFinite _

/-- The upward cylinder event generated by the finite configurations in E,
using exactly their original embedded lattice edges. -/
def embeddedCylinderEvent (f : V ↪ LatticeVertex) (hG : G.map f ≤ squareLattice)
    (E : Set (Configuration G)) : Set LatticeConfiguration :=
  ⋃ A ∈ (Finset.univ.filter fun A : Configuration G => A ∈ E),
    LatticeConfiguration.allOpen (A.map (embeddedEdgeEmbedding G squareLattice f hG))

lemma embeddedCylinderEvent_isClopen (f : V ↪ LatticeVertex) (hG : G.map f ≤ squareLattice)
    (E : Set (Configuration G)) : IsClopen (embeddedCylinderEvent G f hG E) :=
  isClopen_biUnion_finset fun _A _ => LatticeConfiguration.allOpen_isClopen _

lemma mem_embeddedCylinderEvent (f : V ↪ LatticeVertex) (hG : G.map f ≤ squareLattice)
    (E : Set (Configuration G)) (ω : LatticeConfiguration) :
    ω ∈ embeddedCylinderEvent G f hG E ↔ ∃ A : Configuration G, A ∈ E ∧
      ω ∈ LatticeConfiguration.allOpen (A.map (embeddedEdgeEmbedding G squareLattice f hG)) := by
  simp [embeddedCylinderEvent]

omit [Finite V] in
lemma actualConnected_embeddedEdges (f : V ↪ LatticeVertex) (hG : G.map f ≤ squareLattice)
    (A : Configuration G) (u v : V) (h : ActualConnected G A u v) :
    ActualConnected squareLattice (A.map (embeddedEdgeEmbedding G squareLattice f hG)) (f u) (f v) := by
  have hh := (actualConnected_isolatedExtension G f A u v).2 h
  unfold ActualConnected at hh
  rw [← openGraph_subgraphConfigurationEmbedding hG] at hh
  change ActualConnected squareLattice (embeddedConfigurationEmbedding G squareLattice f hG A) _ _ at hh
  rw [embeddedConfigurationEmbedding_eq_map] at hh
  exact hh

lemma embeddedConnectivityEvent_subset (f : V ↪ LatticeVertex) (hG : G.map f ≤ squareLattice)
    (u v : V) : embeddedCylinderEvent G f hG (connectivityEvent G u v) ⊆
      Duality.connectionEvent (f u) (f v) := by
  intro ω hω
  obtain ⟨A,hA,hopen⟩ := (mem_embeddedCylinderEvent G f hG _ ω).1 hω
  exact (Duality.mem_connectionEvent_iff_finite_witness ω (f u) (f v)).2
    ⟨A.map (embeddedEdgeEmbedding G squareLattice f hG),
      actualConnected_embeddedEdges G f hG A u v hA,hopen⟩

end
end PottsDiscontinuity.TorusExploration
